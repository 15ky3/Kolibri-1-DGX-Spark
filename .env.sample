# Kolibri-1 on one DGX Spark — launch profile.
# Precedence: exported environment > .env > this file. Plain KEY=value lines,
# no quoting tricks, an inline comment needs a space before the '#'.

# --- image / model -----------------------------------------------------------
IMAGE=vllm/vllm-openai:v0.30.0          # stock vLLM 0.30.0 arm64 (CUDA 13, sm120 family = GB10)
MODEL_ID=Aleph-Alpha/Kolibri-1          # FP8 128x128 block weights, 78.85 GB
MODEL_REVISION=                         # empty = the snapshot the cache has; set a sha to pin
MODEL_DIR=                              # serve a local checkpoint dir instead (e.g. ~/models/Kolibri-1-NVFP4-experts,
                                        # then WEIGHTS_GIB=43)
SERVED_MODEL_NAME=kolibri-1
HF_HOME=~/models/hf                   # shared hub cache (hub/ lives below it)
VLLM_CACHE=~/.cache/vllm              # torch.compile cache, survives restarts
FLASHINFER_CACHE=~/.cache/flashinfer

# --- network -----------------------------------------------------------------
CONTAINER_NAME=vllm-kolibri-1
BIND=0.0.0.0
PORT=8895
API_KEY=                                # empty = no auth (start.sh warns)

# --- memory (GiB, binary) ----------------------------------------------------
# The GPU budget is derived, not guessed:
#   GMU = (WEIGHTS_GIB + KV_CACHE_GIB + OVERHEAD_GIB) / MemTotal
# and the KV pool is pinned to exactly KV_CACHE_GIB (--kv-cache-memory-bytes),
# so the footprint does not drift with whatever happened to be free at startup.
# Only 10 of the 50 layers are full attention (4 KV heads x 128, FP8), the
# other 40 are a 513-token sliding window. Measured pools: 8 GiB = 666,780
# tokens (at 262k), 16 GiB = 1,576,035 tokens (at 1M). One 1M request needs
# >= 12.6 GiB (start.sh checks). vLLM REPORTS "full max-length requests x
# max_model_len" (it reserves window + prefill chunk per request for the 40
# sliding layers); the physical full-attention slots are ~25 % more.
# 22 GiB (default): reported 1,833,672 at 262k, ~2.31M physical slots; host
# keeps ~12.5 GiB under load. 20 GiB: 1,666,977 (~2.10M physical) / ~14 GiB. Do not go higher.
WEIGHTS_GIB=73.4
KV_CACHE_GIB=22
OVERHEAD_GIB=7                          # activations, CUDA graphs, cuBLAS/Triton workspaces, non-torch
HOST_MIN_FREE_GIB=10                    # start refuses unless MemAvailable >= budget + this
GPU_MEMORY_UTILIZATION=                 # set to override the derived GMU
CONTAINER_MEM_GIB=100                   # cgroup cap for the container's host-side memory

# --- watchdog ----------------------------------------------------------------
MEMWATCH=1                              # stop the container before the box starves
MEMWATCH_MIN_GIB=4                      # MemAvailable floor
MEMWATCH_GRACE=3                        # consecutive 2 s samples below the floor before acting

# --- serving -----------------------------------------------------------------
MAX_MODEL_LEN=262144                    # native; 1048576 works (needle 978k PASS) and adds the hf-override
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
KV_CACHE_DTYPE=fp8                      # what Aleph Alpha evaluated with
ENABLE_PREFIX_CACHING=1
LOAD_STRATEGY=lazy                      # cold load: lazy (mmap) ~500 s, eager 80 s, prefetch 458 s. Same weights,
                                        # same numbers (tests/ppl.py identical); eager is just faster to start
ENFORCE_EAGER=0                         # 1 = no torch.compile / CUDA graphs (debug only)
ATTENTION_BACKEND=                      # empty = vLLM's choice; e.g. TRITON_ATTN or FLASHINFER
LINEAR_BACKEND=                         # empty = auto (CUTLASS block FP8); triton. b12x measured: no gain
SPEC=off                                # off | ngram (2.3x on copy-heavy output, HALVES prose)
SPEC_K=4                                # ngram draft length
MOE_BACKEND=                            # empty = auto (Triton on GB10 for block FP8)
REASONING=1                             # kolibri1 reasoning parser
TOOLS=1                                 # kolibri1 (Hermes) tool parser + auto tool choice
EXTRA_ARGS=                             # appended verbatim to `vllm serve`
EXTRA_DOCKER_ARGS=                      # appended verbatim to `docker run`

# --- start behaviour ---------------------------------------------------------
WAIT_TIMEOUT=1800                       # seconds start.sh waits for /health (0 = do not wait)
